#include <stdio.h>

void solve() {
    int N;
    if (scanf("%d", &N) != 1) return;

    long long A[N];
    long long total_sum = 0;
    for (int i = 0; i < N; i++) {
        scanf("%lld", &A[i]);
        total_sum += A[i];
    }

    // Number of operations K must be -total_sum
    long long K = -total_sum;

    // Condition 1: K must be non-negative
    if (K < 0) {
        printf("-1\n");
        return;
    }

    // Condition 2: For each element, n_i = 2*p_i + A_i. 
    // Since n_i (subtractions) >= 0, then 2*p_i >= -A_i.
    // We sum the minimum required p_i for each element.
    long long min_p_sum = 0;
    for (int i = 0; i < N; i++) {
        if (A[i] < 0) {
            // Need p_i additions such that 2*p_i >= abs(A[i])
            // Equivalent to ceil(abs(A[i]) / 2.0)
            min_p_sum += (-A[i] + 1) / 2;
        }
    }

    // If the total operations K can cover the required additions
    if (min_p_sum <= K) {
        printf("%lld\n", K);
    } else {
        printf("-1\n");
    }
}

int main() {
    int T;
    if (scanf("%d", &T) != 1) return 0;
    while (T--) {
        solve();
    }
    return 0;
}
